      "id": "a1b2c3d4-0001-0001-0001-000000000003",
      "name": "Get Today Checkins"
    },
    {
      "parameters": {
        "jsCode": "const today = $('Get Today').first().json.today;\n\nconst rawSupervisors = $('Get All Supervisors').first().json;\nconst rawCheckins    = $('Get Today Checkins').first().json;\n\nconst supervisors = Array.isArray(rawSupervisors) ? rawSupervisors : [];\nconst checkedIn   = new Set(\n  (Array.isArray(rawCheckins) ? rawCheckins : []).map(c => String(c.chat_id))\n);\n\nconst missing = supervisors.filter(s => {\n  const id = String(s.chat_id ?? '').trim();\n  return id !== '' && !checkedIn.has(id);\n});\n\nif (missing.length === 0) return [];\n\nreturn missing.map(s => ({ json: {\n  chat_id:    String(s.chat_id).trim(),\n  nama:       s.nama || 'Unknown',\n  tanggal:    today,\n  persentase: 0.5\n}}));"
      },
